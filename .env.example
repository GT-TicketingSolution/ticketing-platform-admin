DATABASE_URL=your_database_url_here
MIGRATION_DATABASE_URL=your_migration_database_url_here

SESSION_COOKIE_NAME="ticketing_session"
SESSION_TTL_DAYS="7"

NODE_ENV="development"

APP_URL="http://localhost:3000"

RESEND_API_KEY=your_resend_api_key_here 

# Authentication / Forgot Password Emails
RESEND_AUTH_FROM_EMAIL="no-reply@ticketingsolution.in"
RESEND_AUTH_FROM_NAME="Ticketing Solution"
RESEND_AUTH_SUBJECT="Reset Your Password"
RESEND_AUTH_SIGNATURE="Ticketing Solution"
RESEND_AUTH_RESET_EXPIRY="30 minutes"
RESEND_AUTH_ACCOUNT_TYPE="Admin"

QR_SECRET=your_qr_secret_here

# Seat Management Max Row & Column Limits 
NEXT_PUBLIC_MAX_SEAT_ROWS=100
NEXT_PUBLIC_MAX_SEAT_COLS=100
